// Set Script Properties: SPREADSHEET_ID = your spreadsheet ID. Never commit the ID here.
function book_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw Error('請先設定 SPREADSHEET_ID');return SpreadsheetApp.openById(id)}
function cols_(sh){const h=sh.getRange(1,1,1,sh.getLastColumn()).getDisplayValues()[0].map(s=>s.trim());const c={};for(const name of ['物件名稱','類型','實際入帳日','實收金額','是否已收','備註']){const i=h.indexOf(name);if(i<0)throw Error(sh.getName()+' 缺少欄位：'+name);c[name]=i+1}return c}
function months_(){return book_().getSheets().map(s=>s.getName()).filter(n=>/^\d{4}-(0[1-9]|1[0-2])$/.test(n)).sort()}
function getMonths(){return months_()}
function getRows(month){if(!months_().includes(month))throw Error('月份不存在');const sh=book_().getSheetByName(month),c=cols_(sh),v=sh.getDataRange().getValues(),tz=Session.getScriptTimeZone();return v.slice(1).map((r,i)=>({row:i+2,property:String(r[c['物件名稱']-1]||''),type:String(r[c['類型']-1]||''),date:r[c['實際入帳日']-1] instanceof Date?Utilities.formatDate(r[c['實際入帳日']-1],tz,'yyyy-MM-dd'):'',amount:r[c['實收金額']-1]||'',paid:r[c['是否已收']-1]===true,note:String(r[c['備註']-1]||'')})).filter(x=>x.property)}
function saveRent(p){const lock=LockService.getScriptLock();lock.waitLock(20000);try{if(!months_().includes(p.month))throw Error('月份不存在');const sh=book_().getSheetByName(p.month),c=cols_(sh),row=Number(p.row);if(!Number.isInteger(row)||row<2||row>sh.getLastRow())throw Error('資料列錯誤');if(String(sh.getRange(row,c['物件名稱']).getValue()).trim()!==String(p.property).trim()||String(sh.getRange(row,c['類型']).getValue()).trim()!==String(p.type).trim())throw Error('物件已變動，請重新整理');const amount=p.amount===''?'':Number(p.amount);if(amount!==''&&(!Number.isFinite(amount)||amount<0))throw Error('金額錯誤');if(typeof p.paid!=='boolean')throw Error('收款狀態錯誤');const dt=p.date?new Date(p.date+'T12:00:00'):'';if(p.date&&(!/^\d{4}-\d{2}-\d{2}$/.test(p.date)||isNaN(dt.getTime())||Utilities.formatDate(dt,Session.getScriptTimeZone(),'yyyy-MM-dd')!==p.date))throw Error('日期錯誤');if(p.paid&&(amount===''||amount<=0||!p.date))throw Error('已收款必須填寫金額及入帳日');sh.getRange(row,c['實際入帳日']).setValue(dt);sh.getRange(row,c['實收金額']).setValue(amount);sh.getRange(row,c['是否已收']).setValue(p.paid);sh.getRange(row,c['備註']).setValue(String(p.note||'').slice(0,500));return {success:true}}finally{lock.releaseLock()}}
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('每月收租管理')}
